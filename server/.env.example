# ============================================
# CONFIGURACIÓN DE BASE DE DATOS - NeonDB
# ============================================
# Copia este archivo como .env y completa con tus datos reales
# NUNCA subas el archivo .env a Git

# URL de conexión a NeonDB (la encuentras en tu dashboard de NeonDB)
DATABASE_URL=postgresql://usuario:password@ep-xxxx-xxxx.us-east-2.aws.neon.tech/nombre_db?sslmode=require

# O puedes usar variables separadas:
# DB_HOST=ep-xxxx-xxxx.us-east-2.aws.neon.tech
# DB_PORT=5432
# DB_NAME=nombre_de_tu_base_de_datos
# DB_USER=tu_usuario
# DB_PASSWORD=tu_password

# Puerto del servidor backend
PORT=3001

# Entorno
NODE_ENV=development
